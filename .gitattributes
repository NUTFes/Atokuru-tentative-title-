# 改行コードを LF にそろえる（Windows と Mac で差分が出ないようにする）
* text=auto eol=lf

# Windows でしか使わないスクリプトは CRLF のまま
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 画像などのバイナリは変換しない
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
