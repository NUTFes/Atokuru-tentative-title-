# このファイルを .env にコピーして値を埋める（.env は Git に上げない）
#   cp .env.example .env

# Turso の DB の URL（turso db show --url <DB名> で表示される）
# 手元のファイルで試すときは file:local.db にして、TURSO_AUTH_TOKEN は空にする
TURSO_DATABASE_URL=libsql://<DB名>-<組織名>.turso.io

# Turso の接続トークン（turso db tokens create <DB名> で発行する）
TURSO_AUTH_TOKEN=

# API サーバーのポート（なければ 8080）
PORT=8080

# FE（Next.js の静的エクスポート）を Echo から配信するときの、out/ のディレクトリ
# 空なら API だけを動かす（ローカルで next dev を使うとき）
STATIC_DIR=

# 別のオリジンから API を呼ぶことを許可する（カンマ区切り）。ローカルで next dev から呼ぶときだけ使う
# 本番は FE と API が同じオリジンなので空にする
CORS_ALLOW_ORIGINS=

# 通知（Web Push）に使う VAPID の鍵。3つそろっていないときは通知を使わずに動く
# 鍵は1回だけ作り、作り直さない（作り直すと、それまでの購読がすべて使えなくなる）
#   作り方の例：npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 通知を送る人の連絡先（プッシュサーバーが問題のあるときに連絡する先）。mailto: か https: の URL
VAPID_SUBJECT=

# 備考の定型文を訳す OpenAI の API キーとモデル名。2つそろっていないときは、定型文を訳さずに登録する
# キーは FE には書かない（誰でも見られてしまう）。Git にも上げない
OPENAI_API_KEY=
# 使うモデルの名前（OpenAI のドキュメントのモデル一覧にある名前）
OPENAI_MODEL=
